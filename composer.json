{
    "name": "dashed/dashed-vacancies",
    "description": "Vacancy module for Dashed CMS",
    "keywords": [
        "Dashed",
        "laravel",
        "dashed-vacancies",
        "vacancies",
        "jobs"
    ],
    "homepage": "https://github.com/Dashed-DEV/dashed-vacancies",
    "license": "MIT",
    "authors": [
        {
            "name": "Robin van Maasakker",
            "email": "robin@dashed.nl",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3|^8.4",
        "lara-zeus/spatie-translatable": "^1.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "filament/upgrade": "^4.0",
        "friendsofphp/php-cs-fixer": "^3.63",
        "orchestra/testbench": "^9|^10|^11",
        "pestphp/pest": "^2.35|^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^2.4|^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "Dashed\\DashedVacancies\\": "src",
            "Dashed\\DashedVacancies\\Database\\Factories\\": "database/factories"
        },
        "files": [
            "src/Helpers/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Dashed\\DashedVacancies\\Tests\\": "tests"
        }
    },
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest coverage"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Dashed\\DashedVacancies\\DashedVacanciesServiceProvider"
            ],
            "aliases": {
                "DashedVacancies": "Dashed\\DashedVacancies\\Facades\\DashedVacancies",
                "Vacancies": "Dashed\\DashedVacancies\\Classes\\Vacancies"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
